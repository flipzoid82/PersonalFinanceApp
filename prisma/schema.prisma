generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DataSourceType {
  PLAID
  CSV_IMPORT
  MANUAL
  FIDELITY_IMPORT
  OTHER_PROVIDER
}

enum DataSourceStatus {
  ACTIVE
  INACTIVE
  NEEDS_ATTENTION
  ERROR
}

enum ConnectionStatus {
  ACTIVE
  NEEDS_REAUTHENTICATION
  DISCONNECTED
  ERROR
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  LOAN
  MORTGAGE
  BROKERAGE
  RETIREMENT
  FOUR_O_ONE_K
  MANUAL_ASSET
  MANUAL_DEBT
  OTHER
}

enum AccountSource {
  SYNCED
  IMPORTED
  MANUAL
}

enum TransactionStatus {
  PENDING
  POSTED
  CANCELED
}

enum FinancialRole {
  INCOME
  EXPENSE
  TRANSFER
  REFUND
  CREDIT_CARD_PAYMENT
  INVESTMENT_ACTIVITY
  DEBT_PAYMENT
  BORROWING_PROCEEDS
  IGNORED
  UNCATEGORIZED
}

enum TransactionCategoryKind {
  EXPENSE
  INCOME
}

enum EconomicDirection {
  INFLOW
  OUTFLOW
  UNKNOWN
}

enum ClassificationProvenance {
  OWNER_OVERRIDE
  OWNER_RULE
  SYSTEM
  PROVIDER
  UNRESOLVED
}

enum ClassificationCertainty {
  CONFIRMED
  DETERMINISTIC
  PROVIDER_ONLY
  CONFLICTING
  UNKNOWN
}

enum ClassificationReviewState {
  RESOLVED
  NEEDS_REVIEW
  DEFERRED
}

enum ClassificationRuleMatchType {
  MERCHANT_EXACT
  DESCRIPTION_EXACT
  DESCRIPTION_PREFIX
  DESCRIPTION_CONTAINS
  MERCHANT_ACCOUNT
}

enum TransactionRelationshipType {
  LEGACY_UNTYPED
  INTERNAL_TRANSFER
  CREDIT_CARD_PAYMENT
  REFUND
  REIMBURSEMENT
}

enum TransactionRelationshipState {
  SUGGESTED
  CONFIRMED
  REJECTED
  NEEDS_REVIEW
}

enum RecurringFlowType {
  BILL
  SUBSCRIPTION
  TRANSFER
  DEBT_PAYMENT
  CREDIT_CARD_PAYMENT
  EXPECTED_INCOME
  OTHER
}

enum RecurringFrequency {
  WEEKLY
  BIWEEKLY
  SEMIMONTHLY
  MONTHLY
  BIMONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
  IRREGULAR
}

enum ConfidenceLevel {
  HIGH
  MEDIUM
  LOW
  NEEDS_CONFIRMATION
}

enum RecurringStatus {
  ACTIVE
  INACTIVE
  NEEDS_CONFIRMATION
}

enum CalendarEventType {
  BILL
  SUBSCRIPTION
  DEBT_PAYMENT
  CREDIT_CARD_PAYMENT
  EXPECTED_INCOME
  OTHER_RECURRING
}

enum CalendarDateSource {
  INFERRED
  USER_CONFIRMED
  PROVIDER
  IMPORTED
  MANUAL
}

enum CalendarAmountSource {
  FIXED
  ESTIMATED
  LAST_OBSERVED
  PROVIDER
  IMPORTED
  MANUAL
}

enum CalendarEventStatus {
  PREDICTED
  CONFIRMED
  PAID
  OVERDUE
  SKIPPED
  NEEDS_CONFIRMATION
  INACTIVE
}

enum InvestmentSource {
  SYNCED
  IMPORTED
  MANUAL
}

enum InvestmentTransactionType {
  BUY
  SELL
  DIVIDEND
  INTEREST
  CONTRIBUTION
  WITHDRAWAL
  TRANSFER
  FEE
  OTHER
}

enum ManualAssetType {
  HOME
  OTHER_REAL_ESTATE
  VEHICLE
  PRIVATE_ASSET
  OTHER_ASSET
  MORTGAGE
  AUTO_LOAN
  STUDENT_LOAN
  PERSONAL_LOAN
  OTHER_DEBT
}

enum ImportType {
  BANK_TRANSACTIONS_CSV
  FIDELITY_POSITIONS_CSV
  FIDELITY_TRANSACTIONS_CSV
  MANUAL_BALANCE_SNAPSHOT
  GENERIC_ACCOUNT_BALANCE_CSV
  GENERIC_INVESTMENT_HOLDINGS_CSV
  FIDELITY_NETBENEFITS_STATEMENT
  FIDELITY_BROKERAGE_STATEMENT
  FIDELITY_TRADE_CONFIRMATION
  TSP_STATEMENT
}

enum ImportStatus {
  PENDING
  PROCESSING
  NEEDS_REVIEW
  READY
  COMPLETED
  PARTIAL
  FAILED
  CANCELED
  REVERTED
}

enum ImportCandidateKind {
  BALANCE_SNAPSHOT
  INVESTMENT_BALANCE_SNAPSHOT
  HOLDING
  INVESTMENT_TRANSACTION
  INFORMATIONAL
}

enum ImportCandidateStatus {
  READY
  DUPLICATE
  NEEDS_REVIEW
  REJECTED
  INFORMATIONAL
  SKIPPED
}

enum ImportAccountMatchStatus {
  MATCHED
  NEEDS_REVIEW
  CREATE
}

enum ImportSourceStatus {
  RETAINED
  DELETED
  MISSING
  FAILED
}

model User {
  id                         String                      @id @default(cuid())
  email                      String                      @unique
  displayName                String?                     @map("display_name")
  passwordHash               String                      @map("password_hash")
  sessions                   AuthSession[]
  dataSources                DataSource[]
  institutionConnections     InstitutionConnection[]
  providerAccountLinks       ProviderAccountLink[]
  accountMergeAudits         AccountMergeAudit[]
  accounts                   Account[]
  transactions               Transaction[]
  transactionOverrides       TransactionOverride[]
  transactionCategories      TransactionCategory[]
  transactionClassifications TransactionClassification[]
  classificationRules        ClassificationRule[]
  transactionAllocations     TransactionAllocation[]
  transactionRelationships   TransactionRelationship[]
  recurringStreams           RecurringStream[]
  calendarEvents             CalendarEvent[]
  calendarOverrides          CalendarOverride[]
  investmentHoldings         InvestmentHolding[]
  investmentBalanceSnapshots InvestmentBalanceSnapshot[]
  investmentTransactions     InvestmentTransaction[]
  manualAssets               ManualAsset[]
  balanceSnapshots           BalanceSnapshot[]
  importJobs                 ImportJob[]
  transactionTruthCutoverAt  DateTime?                   @map("transaction_truth_cutover_at")
  transactionTruthVersion    Int?                        @map("transaction_truth_version")
  createdAt                  DateTime                    @default(now()) @map("created_at")
  updatedAt                  DateTime                    @updatedAt @map("updated_at")

  @@map("users")
}

model AuthSession {
  id                String    @id @default(cuid())
  tokenHash         String    @unique @map("token_hash")
  userId            String    @map("user_id")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  authenticatedAt   DateTime  @map("authenticated_at")
  lastActivityAt    DateTime  @map("last_activity_at")
  idleExpiresAt     DateTime  @map("idle_expires_at")
  absoluteExpiresAt DateTime  @map("absolute_expires_at")
  revokedAt         DateTime? @map("revoked_at")
  revocationReason  String?   @map("revocation_reason")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@index([userId, revokedAt])
  @@index([idleExpiresAt])
  @@index([absoluteExpiresAt])
  @@map("auth_sessions")
}

model DataSource {
  id                     String                  @id @default(cuid())
  userId                 String                  @map("user_id")
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceType             DataSourceType          @map("source_type")
  displayName            String                  @map("display_name")
  status                 DataSourceStatus        @default(ACTIVE)
  lastUpdatedAt          DateTime?               @map("last_updated_at")
  institutionConnections InstitutionConnection[]
  accounts               Account[]
  importJobs             ImportJob[]
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")

  @@index([userId])
  @@index([userId, sourceType])
  @@map("data_sources")
}

model InstitutionConnection {
  id                   String                @id @default(cuid())
  userId               String                @map("user_id")
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  dataSourceId         String                @map("data_source_id")
  dataSource           DataSource            @relation(fields: [dataSourceId], references: [id], onDelete: NoAction)
  provider             String
  providerItemId       String?               @map("provider_item_id")
  linkSessionId        String?               @unique @map("link_session_id")
  institutionId        String?               @map("institution_id")
  institutionName      String                @map("institution_name")
  encryptedAccessToken String?               @map("encrypted_access_token")
  status               ConnectionStatus      @default(ACTIVE)
  syncCursor           String?               @map("sync_cursor")
  syncStartedAt        DateTime?             @map("sync_started_at")
  lastAttemptedSyncAt  DateTime?             @map("last_attempted_sync_at")
  lastSuccessfulSyncAt DateTime?             @map("last_successful_sync_at")
  lastErrorCode        String?               @map("last_error_code")
  lastErrorMessage     String?               @map("last_error_message")
  disconnectedAt       DateTime?             @map("disconnected_at")
  accounts             Account[]
  providerAccountLinks ProviderAccountLink[]
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  @@unique([provider, providerItemId])
  @@index([userId])
  @@index([dataSourceId])
  @@index([institutionId])
  @@index([userId, status])
  @@index([syncStartedAt])
  @@map("institution_connections")
}

model Account {
  id                      String                      @id @default(cuid())
  userId                  String                      @map("user_id")
  user                    User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  dataSourceId            String                      @map("data_source_id")
  dataSource              DataSource                  @relation(fields: [dataSourceId], references: [id], onDelete: NoAction)
  institutionConnectionId String?                     @map("institution_connection_id")
  institutionConnection   InstitutionConnection?      @relation(fields: [institutionConnectionId], references: [id], onDelete: SetNull)
  providerAccountId       String?                     @map("provider_account_id")
  providerIdentityKey     String?                     @map("provider_identity_key") @db.VarChar(80)
  mask                    String?
  name                    String
  officialName            String?                     @map("official_name")
  institutionName         String?                     @map("institution_name")
  accountType             AccountType                 @map("account_type")
  accountSubtype          String?                     @map("account_subtype")
  source                  AccountSource
  currency                String                      @default("USD") @db.Char(3)
  currentBalance          Decimal                     @map("current_balance") @db.Decimal(19, 4)
  balanceAvailable        Boolean                     @default(true) @map("balance_available")
  availableBalance        Decimal?                    @map("available_balance") @db.Decimal(19, 4)
  creditLimit             Decimal?                    @map("credit_limit") @db.Decimal(19, 4)
  isManual                Boolean                     @default(false) @map("is_manual")
  isActive                Boolean                     @default(true) @map("is_active")
  lastSyncedAt            DateTime?                   @map("last_synced_at")
  lastImportedAt          DateTime?                   @map("last_imported_at")
  notes                   String?
  transactions            Transaction[]
  classificationRules     ClassificationRule[]
  recurringStreams        RecurringStream[]
  calendarEvents          CalendarEvent[]
  investmentHoldings      InvestmentHolding[]
  investmentSnapshots     InvestmentBalanceSnapshot[]
  investmentTransactions  InvestmentTransaction[]
  balanceSnapshots        BalanceSnapshot[]
  importAccountMatches    ImportAccountMatch[]
  matchedImportJobs       ImportJob[]                 @relation("ImportMatchedAccount")
  createdByImportJobId    String?                     @map("created_by_import_job_id")
  createdByImportJob      ImportJob?                  @relation("ImportCreatedAccounts", fields: [createdByImportJobId], references: [id], onDelete: NoAction)
  providerAccountLinks    ProviderAccountLink[]
  createdAt               DateTime                    @default(now()) @map("created_at")
  updatedAt               DateTime                    @updatedAt @map("updated_at")

  @@unique([dataSourceId, providerAccountId])
  @@unique([id, userId])
  @@unique([userId, providerIdentityKey])
  @@index([userId])
  @@index([userId, accountType, isActive])
  @@index([institutionConnectionId])
  @@index([institutionName])
  @@index([createdByImportJobId])
  @@map("accounts")
}

model ProviderAccountLink {
  userId                  String                @map("user_id")
  user                    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider                String
  providerAccountId       String                @map("provider_account_id")
  logicalIdentityKey      String?               @map("logical_identity_key") @db.VarChar(80)
  accountId               String                @map("account_id")
  account                 Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  institutionConnectionId String                @map("institution_connection_id")
  institutionConnection   InstitutionConnection @relation(fields: [institutionConnectionId], references: [id], onDelete: Cascade)
  isCurrent               Boolean               @default(false) @map("is_current")
  firstSeenAt             DateTime              @default(now()) @map("first_seen_at")
  lastSeenAt              DateTime              @default(now()) @map("last_seen_at")

  @@id([userId, provider, providerAccountId])
  @@unique([institutionConnectionId, accountId])
  @@index([accountId])
  @@index([institutionConnectionId, isCurrent])
  @@index([userId, logicalIdentityKey])
  @@map("provider_account_links")
}

model AccountMergeAudit {
  id                 String   @id @default(cuid())
  userId             String   @map("user_id")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider           String
  canonicalAccountId String   @map("canonical_account_id")
  duplicateAccountId String   @unique @map("duplicate_account_id")
  reason             String
  snapshot           Json
  mergedAt           DateTime @default(now()) @map("merged_at")

  @@index([userId, canonicalAccountId])
  @@map("account_merge_audits")
}

model Transaction {
  id                           String                     @id @default(cuid())
  userId                       String                     @map("user_id")
  user                         User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId                    String                     @map("account_id")
  account                      Account                    @relation(fields: [accountId], references: [id], onDelete: NoAction)
  providerTransactionId        String?                    @map("provider_transaction_id")
  originalName                 String                     @map("original_name")
  merchantName                 String?                    @map("merchant_name")
  amount                       Decimal                    @db.Decimal(19, 4)
  currency                     String                     @default("USD") @db.Char(3)
  authorizedAt                 DateTime?                  @map("authorized_at")
  postedAt                     DateTime?                  @map("posted_at")
  status                       TransactionStatus
  providerCategory             String?                    @map("provider_category")
  providerCategoryConfidence   Decimal?                   @map("provider_category_confidence") @db.Decimal(5, 4)
  pendingProviderTransactionId String?                    @map("pending_provider_transaction_id")
  pendingTransactionId         String?                    @map("pending_transaction_id")
  pendingTransaction           Transaction?               @relation("PendingToPosted", fields: [pendingTransactionId], references: [id], onDelete: SetNull)
  postedTransactions           Transaction[]              @relation("PendingToPosted")
  rawProviderPayload           Json?                      @map("raw_provider_payload")
  removedAt                    DateTime?                  @map("removed_at")
  override                     TransactionOverride?       @relation("SourceTransactionOverride")
  linkedByOverrides            TransactionOverride[]      @relation("LinkedTransactionOverride")
  classification               TransactionClassification?
  allocations                  TransactionAllocation[]
  outgoingRelationships        TransactionRelationship[]  @relation("RelationshipSource")
  incomingRelationships        TransactionRelationship[]  @relation("RelationshipTarget")
  calendarEvents               CalendarEvent[]
  createdAt                    DateTime                   @default(now()) @map("created_at")
  updatedAt                    DateTime                   @updatedAt @map("updated_at")

  @@unique([accountId, providerTransactionId])
  @@unique([id, userId])
  @@index([userId])
  @@index([accountId, postedAt])
  @@index([merchantName])
  @@index([status])
  @@index([pendingTransactionId])
  @@map("transactions")
}

model TransactionOverride {
  id                        String               @id @default(cuid())
  userId                    String               @map("user_id")
  user                      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactionId             String               @unique @map("transaction_id")
  transaction               Transaction          @relation("SourceTransactionOverride", fields: [transactionId], references: [id], onDelete: Cascade)
  merchantNameOverride      String?              @map("merchant_name_override")
  categoryOverride          String?              @map("category_override")
  transactionCategoryId     String?              @map("transaction_category_id")
  transactionCategory       TransactionCategory? @relation(fields: [transactionCategoryId], references: [id], onDelete: SetNull)
  financialRoleOverride     FinancialRole?       @map("financial_role_override")
  economicDirectionOverride EconomicDirection?   @map("economic_direction_override")
  reviewedAt                DateTime?            @map("reviewed_at")
  notes                     String?
  excludedFromReports       Boolean              @default(false) @map("excluded_from_reports")
  linkedTransactionId       String?              @map("linked_transaction_id")
  linkedTransaction         Transaction?         @relation("LinkedTransactionOverride", fields: [linkedTransactionId], references: [id], onDelete: SetNull)
  createdAt                 DateTime             @default(now()) @map("created_at")
  updatedAt                 DateTime             @updatedAt @map("updated_at")

  @@index([userId])
  @@index([linkedTransactionId])
  @@index([transactionCategoryId])
  @@map("transaction_overrides")
}

model TransactionCategory {
  id              String                      @id @default(cuid())
  userId          String                      @map("user_id")
  user            User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  systemKey       String?                     @map("system_key")
  kind            TransactionCategoryKind
  name            String
  normalizedName  String                      @map("normalized_name")
  isActive        Boolean                     @default(true) @map("is_active")
  displayOrder    Int                         @default(0) @map("display_order")
  classifications TransactionClassification[]
  overrides       TransactionOverride[]
  rules           ClassificationRule[]
  allocations     TransactionAllocation[]
  createdAt       DateTime                    @default(now()) @map("created_at")
  updatedAt       DateTime                    @updatedAt @map("updated_at")

  @@unique([userId, systemKey])
  @@unique([userId, normalizedName])
  @@unique([id, userId])
  @@index([userId, kind, isActive, displayOrder])
  @@map("transaction_categories")
}

model TransactionClassification {
  id                    String                    @id @default(cuid())
  userId                String                    @map("user_id")
  user                  User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactionId         String                    @unique @map("transaction_id")
  transaction           Transaction               @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  financialRole         FinancialRole?            @map("financial_role")
  transactionCategoryId String?                   @map("transaction_category_id")
  transactionCategory   TransactionCategory?      @relation(fields: [transactionCategoryId], references: [id], onDelete: SetNull)
  economicDirection     EconomicDirection         @default(UNKNOWN) @map("economic_direction")
  roleProvenance        ClassificationProvenance  @default(UNRESOLVED) @map("role_provenance")
  categoryProvenance    ClassificationProvenance  @default(UNRESOLVED) @map("category_provenance")
  directionProvenance   ClassificationProvenance  @default(UNRESOLVED) @map("direction_provenance")
  roleCertainty         ClassificationCertainty   @default(UNKNOWN) @map("role_certainty")
  categoryCertainty     ClassificationCertainty   @default(UNKNOWN) @map("category_certainty")
  directionCertainty    ClassificationCertainty   @default(UNKNOWN) @map("direction_certainty")
  reviewState           ClassificationReviewState @default(NEEDS_REVIEW) @map("review_state")
  reasonCodes           String[]                  @default([]) @map("reason_codes")
  classifierVersion     Int                       @map("classifier_version")
  evidence              Json?
  deferredUntil         DateTime?                 @map("deferred_until")
  classifiedAt          DateTime                  @default(now()) @map("classified_at")
  createdAt             DateTime                  @default(now()) @map("created_at")
  updatedAt             DateTime                  @updatedAt @map("updated_at")

  @@index([userId, reviewState, deferredUntil])
  @@index([userId, financialRole])
  @@index([userId, transactionCategoryId])
  @@index([userId, economicDirection])
  @@index([userId, classifierVersion])
  @@map("transaction_classifications")
}

model ClassificationRule {
  id                    String                      @id @default(cuid())
  userId                String                      @map("user_id")
  user                  User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchType             ClassificationRuleMatchType @map("match_type")
  normalizedValue       String                      @map("normalized_value")
  accountId             String?                     @map("account_id")
  account               Account?                    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transactionCategoryId String?                     @map("transaction_category_id")
  transactionCategory   TransactionCategory?        @relation(fields: [transactionCategoryId], references: [id], onDelete: SetNull)
  financialRole         FinancialRole?              @map("financial_role")
  economicDirection     EconomicDirection?          @map("economic_direction")
  priority              Int                         @default(100)
  isActive              Boolean                     @default(true) @map("is_active")
  appliesFrom           DateTime                    @default(now()) @map("applies_from")
  ruleVersion           Int                         @default(1) @map("rule_version")
  createdAt             DateTime                    @default(now()) @map("created_at")
  updatedAt             DateTime                    @updatedAt @map("updated_at")

  @@index([userId, isActive, priority])
  @@index([userId, matchType, normalizedValue])
  @@index([accountId])
  @@map("classification_rules")
}

model TransactionAllocation {
  id                    String                   @id @default(cuid())
  userId                String                   @map("user_id")
  user                  User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactionId         String                   @map("transaction_id")
  transaction           Transaction              @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  transactionCategoryId String                   @map("transaction_category_id")
  transactionCategory   TransactionCategory      @relation(fields: [transactionCategoryId], references: [id], onDelete: Restrict)
  amount                Decimal                  @db.Decimal(19, 4)
  displayOrder          Int                      @default(0) @map("display_order")
  provenance            ClassificationProvenance @default(OWNER_OVERRIDE)
  reviewedAt            DateTime?                @map("reviewed_at")
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")

  @@unique([transactionId, transactionCategoryId])
  @@unique([transactionId, displayOrder])
  @@index([userId, transactionCategoryId])
  @@map("transaction_allocations")
}

model TransactionRelationship {
  id                  String                       @id @default(cuid())
  userId              String                       @map("user_id")
  user                User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceTransactionId String                       @map("source_transaction_id")
  sourceTransaction   Transaction                  @relation("RelationshipSource", fields: [sourceTransactionId], references: [id], onDelete: Cascade)
  targetTransactionId String                       @map("target_transaction_id")
  targetTransaction   Transaction                  @relation("RelationshipTarget", fields: [targetTransactionId], references: [id], onDelete: Cascade)
  type                TransactionRelationshipType
  appliedAmount       Decimal?                     @map("applied_amount") @db.Decimal(19, 4)
  provenance          ClassificationProvenance     @default(SYSTEM)
  certainty           ClassificationCertainty      @default(UNKNOWN)
  state               TransactionRelationshipState @default(SUGGESTED)
  reasonCodes         String[]                     @default([]) @map("reason_codes")
  evidence            Json?
  confirmedAt         DateTime?                    @map("confirmed_at")
  createdAt           DateTime                     @default(now()) @map("created_at")
  updatedAt           DateTime                     @updatedAt @map("updated_at")

  @@unique([userId, type, sourceTransactionId, targetTransactionId])
  @@index([userId, state, type])
  @@index([sourceTransactionId])
  @@index([targetTransactionId])
  @@map("transaction_relationships")
}

model RecurringStream {
  id                   String             @id @default(cuid())
  userId               String             @map("user_id")
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchantName         String?            @map("merchant_name")
  description          String
  flowType             RecurringFlowType  @map("flow_type")
  frequency            RecurringFrequency
  averageAmount        Decimal            @map("average_amount") @db.Decimal(19, 4)
  lastAmount           Decimal            @map("last_amount") @db.Decimal(19, 4)
  firstDate            DateTime           @map("first_date") @db.Date
  lastDate             DateTime           @map("last_date") @db.Date
  predictedNextDate    DateTime           @map("predicted_next_date") @db.Date
  predictedPostingDate DateTime?          @map("predicted_posting_date") @db.Date
  confirmedDueDate     DateTime?          @map("confirmed_due_date") @db.Date
  dateSource           CalendarDateSource @map("date_source")
  confidenceLevel      ConfidenceLevel    @map("confidence_level")
  confidenceScore      Decimal?           @map("confidence_score") @db.Decimal(5, 4)
  isActive             Boolean            @default(true) @map("is_active")
  status               RecurringStatus    @default(ACTIVE)
  category             String?
  typicalAccountId     String?            @map("typical_account_id")
  detectionKey         String?            @map("detection_key")
  detectionVersion     Int?               @map("detection_version")
  detectionMetadata    Json?              @map("detection_metadata")
  lastDetectedAt       DateTime?          @map("last_detected_at")
  typicalAccount       Account?           @relation(fields: [typicalAccountId], references: [id], onDelete: NoAction)
  calendarEvents       CalendarEvent[]
  calendarOverrides    CalendarOverride[]
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  @@unique([userId, detectionKey])
  @@index([userId])
  @@index([userId, predictedNextDate])
  @@index([typicalAccountId])
  @@map("recurring_streams")
}

model CalendarEvent {
  id                   String               @id @default(cuid())
  userId               String               @map("user_id")
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurringStreamId    String?              @map("recurring_stream_id")
  recurringStream      RecurringStream?     @relation(fields: [recurringStreamId], references: [id], onDelete: SetNull)
  accountId            String?              @map("account_id")
  account              Account?             @relation(fields: [accountId], references: [id], onDelete: NoAction)
  linkedTransactionId  String?              @map("linked_transaction_id")
  linkedTransaction    Transaction?         @relation(fields: [linkedTransactionId], references: [id], onDelete: SetNull)
  eventType            CalendarEventType    @map("event_type")
  title                String
  eventDate            DateTime             @map("event_date") @db.Date
  predictedPostingDate DateTime?            @map("predicted_posting_date") @db.Date
  expectedAmount       Decimal?             @map("expected_amount") @db.Decimal(19, 4)
  actualAmount         Decimal?             @map("actual_amount") @db.Decimal(19, 4)
  currency             String               @default("USD") @db.Char(3)
  dateSource           CalendarDateSource   @map("date_source")
  amountSource         CalendarAmountSource @map("amount_source")
  confidenceLevel      ConfidenceLevel      @map("confidence_level")
  status               CalendarEventStatus
  isUserConfirmed      Boolean              @default(false) @map("is_user_confirmed")
  notes                String?
  projectionKey        String?              @map("projection_key")
  overrides            CalendarOverride[]
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  @@unique([userId, projectionKey])
  @@unique([userId, linkedTransactionId])
  @@index([userId])
  @@index([userId, eventDate])
  @@index([status, eventDate])
  @@index([recurringStreamId])
  @@index([accountId])
  @@index([linkedTransactionId])
  @@map("calendar_events")
}

model CalendarOverride {
  id                     String               @id @default(cuid())
  userId                 String               @map("user_id")
  user                   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendarEventId        String?              @map("calendar_event_id")
  calendarEvent          CalendarEvent?       @relation(fields: [calendarEventId], references: [id], onDelete: Cascade)
  recurringStreamId      String?              @map("recurring_stream_id")
  recurringStream        RecurringStream?     @relation(fields: [recurringStreamId], references: [id], onDelete: Cascade)
  confirmedDueDate       DateTime?            @map("confirmed_due_date") @db.Date
  expectedAmountOverride Decimal?             @map("expected_amount_override") @db.Decimal(19, 4)
  frequencyOverride      RecurringFrequency?  @map("frequency_override")
  statusOverride         CalendarEventStatus? @map("status_override")
  notABill               Boolean              @default(false) @map("not_a_bill")
  notes                  String?
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")

  @@index([userId])
  @@index([calendarEventId])
  @@index([recurringStreamId])
  @@map("calendar_overrides")
}

