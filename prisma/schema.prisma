model ImportJob {
  id                     String                      @id @default(cuid())
  userId                 String                      @map("user_id")
  user                   User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  dataSourceId           String                      @map("data_source_id")
  dataSource             DataSource                  @relation(fields: [dataSourceId], references: [id], onDelete: NoAction)
  sourceName             String                      @map("source_name")
  sourceContentType      String?                     @map("source_content_type")
  sourceSize             Int?                        @map("source_size")
  fileFingerprint        String?                     @map("file_fingerprint") @db.Char(64)
  importType             ImportType                  @map("import_type")
  status                 ImportStatus                @default(PENDING)
  parserFamily           String?                     @map("parser_family")
  parserVersion          String?                     @map("parser_version")
  statementStartAt       DateTime?                   @map("statement_start_at") @db.Date
  statementEndAt         DateTime?                   @map("statement_end_at") @db.Date
  asOfDate               DateTime?                   @map("as_of_date")
  currency               String?                     @db.Char(3)
  planVersion            Int?                        @map("plan_version")
  planFingerprint        String?                     @map("plan_fingerprint") @db.Char(64)
  planData               Json?                       @map("plan_data")
  sourceStorageKey       String?                     @map("source_storage_key") @db.VarChar(80)
  sourceStatus           ImportSourceStatus?         @map("source_status")
  sourceRetainUntil      DateTime?                   @map("source_retain_until")
  sourceDeletedAt        DateTime?                   @map("source_deleted_at")
  matchedAccountId       String?                     @map("matched_account_id")
  matchedAccount         Account?                    @relation("ImportMatchedAccount", fields: [matchedAccountId], references: [id], onDelete: NoAction)
  importedRowCount       Int                         @default(0) @map("imported_row_count")
  duplicateRowCount      Int                         @default(0) @map("duplicate_row_count")
  rejectedRowCount       Int                         @default(0) @map("rejected_row_count")
  reviewRowCount         Int                         @default(0) @map("review_row_count")
  informationalRowCount  Int                         @default(0) @map("informational_row_count")
  failureCode            String?                     @map("failure_code")
  accountMatches         ImportAccountMatch[]
  candidates             ImportCandidate[]
  createdAccounts        Account[]                   @relation("ImportCreatedAccounts")
  balanceSnapshots       BalanceSnapshot[]
  investmentSnapshots    InvestmentBalanceSnapshot[]
  investmentHoldings     InvestmentHolding[]
  investmentTransactions InvestmentTransaction[]
  createdAt              DateTime                    @default(now()) @map("created_at")
  updatedAt              DateTime                    @default(now()) @updatedAt @map("updated_at")
  completedAt            DateTime?                   @map("completed_at")
  revertedAt             DateTime?                   @map("reverted_at")

  @@index([userId])
  @@index([dataSourceId])
  @@index([userId, status, createdAt])
  @@index([userId, fileFingerprint])
  @@index([sourceStatus, sourceRetainUntil])
  @@map("import_jobs")
}

model ImportAccountMatch {
  id               String                   @id @default(cuid())
  importJobId      String                   @map("import_job_id")
  importJob        ImportJob                @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  sourceKey        String                   @map("source_key")
  displayName      String                   @map("display_name")
  institutionName  String?                  @map("institution_name")
  maskedIdentifier String?                  @map("masked_identifier")
  accountType      AccountType              @map("account_type")
  accountSubtype   String?                  @map("account_subtype")
  currency         String                   @db.Char(3)
  status           ImportAccountMatchStatus
  matchedAccountId String?                  @map("matched_account_id")
  matchedAccount   Account?                 @relation(fields: [matchedAccountId], references: [id], onDelete: NoAction)
  reason           String?
  candidates       ImportCandidate[]
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  @@unique([importJobId, sourceKey])
  @@index([matchedAccountId])
  @@map("import_account_matches")
}

model ImportCandidate {
  id                String                @id @default(cuid())
  importJobId       String                @map("import_job_id")
  importJob         ImportJob             @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  accountMatchId    String?               @map("account_match_id")
  accountMatch      ImportAccountMatch?   @relation(fields: [accountMatchId], references: [id], onDelete: NoAction)
  ordinal           Int
  kind              ImportCandidateKind
  status            ImportCandidateStatus
  sourceFingerprint String                @map("source_fingerprint") @db.Char(64)
  sourceLabel       String?               @map("source_label")
  proposedData      Json?                 @map("proposed_data")
  evidence          Json
  reviewReason      String?               @map("review_reason")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  @@unique([importJobId, sourceFingerprint])
  @@index([importJobId, status, ordinal])
  @@index([accountMatchId])
  @@map("import_candidates")
}
