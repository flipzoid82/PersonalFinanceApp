# PostgreSQL connection string used by Prisma. Change the credentials outside development.
DATABASE_URL="postgresql://finance:finance_dev_only@localhost:5432/personal_finance?schema=public"

# Absolute URL where this application is served.
APP_URL="http://localhost:3000"

# At least 32 random characters. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-at-least-32-random-characters"

# Server-authoritative session policy. Shorter values may be used locally for
# physical testing; keep production values at or above these defaults.
SESSION_IDLE_TIMEOUT_SECONDS="900"
SESSION_WARNING_THRESHOLD_SECONDS="120"
SESSION_ABSOLUTE_TIMEOUT_SECONDS="28800"
SESSION_ACTIVITY_THROTTLE_SECONDS="60"

# Reserved for non-Plaid provider tokens; exactly 64 hexadecimal characters.
TOKEN_ENCRYPTION_KEY="replace-with-64-hexadecimal-characters-000000000000000000000"

# Plaid developer-dashboard Sandbox credentials. Never use Production values here.
PLAID_CLIENT_ID="replace-with-plaid-sandbox-client-id"
PLAID_SECRET="replace-with-plaid-sandbox-secret"
PLAID_ENV="sandbox"

# Public HTTPS endpoint that forwards to /api/plaid/webhook.
PLAID_WEBHOOK_URL="https://replace-with-your-tunnel.example/api/plaid/webhook"

# Dedicated AES-256-GCM key for Plaid access tokens. Generate 32 random bytes
# as exactly 64 hexadecimal characters. It must differ from TOKEN_ENCRYPTION_KEY.
PLAID_TOKEN_ENCRYPTION_KEY="replace-with-64-hexadecimal-characters-000000000000000000000"
